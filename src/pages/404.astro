---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import Icon from '@/components/Icon.astro';
import { withBase } from '@/lib/paths';
---

<BaseLayout title="Page not found" noindex>
  <PageHeader eyebrow="404" title="Page not found" lede="The page you were looking for doesn’t exist or has moved.">
    <div class="btn-row">
      <a class="btn btn--primary" href={withBase('/projects/')}>
        Browse projects
        <Icon name="arrow-right" />
      </a>
      <a class="btn btn--ghost" href={withBase('/')}>Home</a>
    </div>
  </PageHeader>
</BaseLayout>
