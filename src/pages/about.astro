---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import PlaceholderNote from '@/components/PlaceholderNote.astro';
import SkillGroups from '@/components/SkillGroups.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import ProfileLinks from '@/components/ProfileLinks.astro';
import Icon from '@/components/Icon.astro';
import { getProjects, projectUrl } from '@/lib/projects';
import { site } from '@/config/site';

const projects = await getProjects();
// Featured projects first; otherwise the most recent work.
const highlighted = projects.filter((p) => p.data.featured).length
  ? projects.filter((p) => p.data.featured)
  : projects.slice(0, 3);
const hasBio = site.bio.length > 0;
const showPending = import.meta.env.DEV;
---

<BaseLayout title="About" description={`About ${site.name}: sports analytics projects, approach and tools.`}>
  <PageHeader
    eyebrow="About"
    title="Sports questions, answered with care."
    lede="I build end-to-end analytics projects around specific questions in professional and collegiate sports."
  />

  <section class="section surface-light" aria-labelledby="approach-title">
    <div class="container about-grid">
      <div class="about-main">
        {
          hasBio && (
            <>
              <h2 id="profile-title">Profile</h2>
              <div class="about-copy">
                {site.bio.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </>
          )
        }
        {
          !hasBio && showPending && (
            <>
              <h2 id="profile-title">Profile</h2>
              <PlaceholderNote label="Pending — dev only" title="Personal bio to be written">
                <p>Add your professional summary to <code>bio</code> in <code>src/config/site.ts</code>. Until then this section is hidden on the public site.</p>
              </PlaceholderNote>
            </>
          )
        }

        <h2 id="approach-title">My approach</h2>
        <div class="about-copy">
          <p>Every project starts with a question a fan, analyst or front office would actually ask, not with a dataset looking for a use.</p>
          <p>From there the work follows the whole path: sourcing the data, checking it against independent sources, modelling it transparently and presenting the result in a form people can explore. Methodological decisions, rejected alternatives and known limitations are documented alongside the results, so readers can judge how much weight a finding deserves.</p>
        </div>
      </div>

      <aside class="about-side" aria-label="Links and featured work">
        <div class="side-card">
          <h2 class="side-card__title">Find me online</h2>
          <ProfileLinks />
        </div>

        {
          highlighted.length > 0 && (
            <div class="side-card">
              <h2 class="side-card__title">Featured work</h2>
              <ul class="focus-list" role="list">
                {highlighted.map((p) => (
                  <li>
                    <a href={projectUrl(p)}>
                      <span class="focus-list__title">{p.data.title}</span>
                      <span class="focus-list__meta">
                        {p.data.sport} · {p.data.timePeriod}
                      </span>
                      <Icon name="arrow-right" />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>
  </section>

  <section class="section surface-alt" aria-labelledby="skills-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Skills & tools</p>
        <h2 id="skills-title">What I work with</h2>
      </div>
      <SkillGroups />
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  .about-grid {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 60rem) {
    .about-grid {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
      gap: var(--space-8);
      align-items: start;
    }
  }

  .about-main {
    display: grid;
    gap: var(--space-5);
    max-width: var(--width-prose);
  }

  .about-main h2 {
    font-size: var(--text-2xl);
  }

  .about-main h2:not(:first-child) {
    margin-top: var(--space-5);
  }

  .about-copy {
    display: grid;
    gap: var(--space-4);
    font-size: var(--text-lg);
    line-height: 1.7;
  }

  .about-side {
    display: grid;
    gap: var(--space-5);
  }

  .side-card {
    padding: var(--space-5);
    background: var(--white);
    border: var(--border);
    border-radius: var(--radius-lg);
    display: grid;
    gap: var(--space-4);
  }

  .side-card__title {
    font-size: var(--text-xs);
    font-family: var(--font-body);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .focus-list {
    list-style: none;
    padding: 0;
  }

  .focus-list a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0 var(--space-3);
    align-items: center;
    text-decoration: none;
  }

  .focus-list__title {
    font-family: var(--font-display);
    font-weight: 700;
  }

  .focus-list__meta {
    grid-row: 2;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .focus-list a :global(svg) {
    grid-row: 1 / span 2;
    grid-column: 2;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--accent-strong);
    transition: transform var(--duration) var(--ease);
  }

  .focus-list a:hover :global(svg) {
    transform: translateX(3px);
  }

  .focus-list a:hover .focus-list__title {
    text-decoration: underline;
  }
</style>
