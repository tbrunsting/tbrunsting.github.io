---
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import { inflateSync } from 'node:zlib';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import PlaceholderNote from '@/components/PlaceholderNote.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';
import { withBase } from '@/lib/paths';

const { pdf, updated } = site.resume;

// Fail loudly rather than publish a broken download link.
if (pdf && !existsSync(join(process.cwd(), 'public', pdf))) {
  throw new Error(`site.resume.pdf is "${pdf}", but public${pdf} does not exist.`);
}

/**
 * Best-effort guard against publishing an outdated resume: refuse to build if
 * the PDF's readable text (raw, plus any Flate-compressed streams) contains a
 * university (.edu) email address. PDFs can encode text in ways this cannot
 * read, so still check the file by eye before setting resume.pdf.
 */
function findEduEmails(file: string): string[] {
  const bytes = readFileSync(file);
  const raw = bytes.toString('latin1');
  let text = raw;
  const streamRe = /stream\r?\n/g;
  let match: RegExpExecArray | null;
  while ((match = streamRe.exec(raw))) {
    const start = match.index + match[0].length;
    const end = raw.indexOf('endstream', start);
    if (end === -1) break;
    try {
      text += '\n' + inflateSync(bytes.subarray(start, end)).toString('latin1');
    } catch {
      /* not a Flate stream (e.g. an image); skip */
    }
    streamRe.lastIndex = end;
  }
  return [...new Set(text.match(/[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.edu\b/gi) ?? [])];
}

if (pdf) {
  const eduEmails = findEduEmails(join(process.cwd(), 'public', pdf));
  if (eduEmails.length) {
    throw new Error(
      `The resume PDF (public${pdf}) contains a university email (${eduEmails.join(', ')}). ` +
        'Replace it with an up-to-date resume before publishing.',
    );
  }
}

const pdfUrl = pdf ? withBase(pdf) : null;
/** Filename offered when downloading, e.g. 'Tyler-Brunsting-Resume.pdf'. */
const downloadName = pdf ? pdf.split('/').pop() : undefined;
const showPending = import.meta.env.DEV;
---

<BaseLayout
  title="Resume"
  description={pdfUrl ? `Resume of ${site.name}: view online or download the PDF.` : `Resume of ${site.name}.`}
  noindex={!pdfUrl}
>
  <PageHeader
    eyebrow="Resume"
    title="Resume"
    lede={pdfUrl ? 'One page, as a PDF. View it in your browser or download a copy.' : undefined}
  >
    {
      pdfUrl && (
        <div class="btn-row">
          <a class="btn btn--primary" href={pdfUrl} target="_blank" rel="noopener">
            <Icon name="file" />
            View Resume
            <span class="visually-hidden">(PDF, opens in a new tab)</span>
          </a>
          <a class="btn btn--ghost" href={pdfUrl} download={downloadName}>
            <Icon name="download" />
            Download PDF
          </a>
        </div>
      )
    }
    {updated && <p class="resume-updated">Last updated {updated}</p>}
  </PageHeader>

  <section class="section surface-light">
    <div class="container">
      {
        pdfUrl ? (
          <>
            {/* Wide screens: the resume inline. */}
            <div class="resume-viewer">
              <object data={pdfUrl} type="application/pdf" title={`${site.name} resume (PDF)`}>
                <p class="resume-fallback">
                  Your browser can’t display the PDF here.{' '}
                  <a href={pdfUrl} download={downloadName}>
                    Download the resume
                  </a>{' '}
                  instead.
                </p>
              </object>
            </div>
            {/* Phones: inline PDF viewers are unreliable, so offer clear actions instead. */}
            <div class="resume-mobile">
              <span class="resume-mobile__icon" aria-hidden="true">
                <Icon name="file" />
              </span>
              <p class="resume-mobile__title">{site.name} — Resume</p>
              <p class="resume-mobile__meta">PDF · one page</p>
              <div class="btn-row resume-mobile__actions">
                <a class="btn btn--primary" href={pdfUrl} target="_blank" rel="noopener">
                  View Resume
                  <span class="visually-hidden">(PDF, opens in a new tab)</span>
                </a>
                <a class="btn btn--ghost" href={pdfUrl} download={downloadName}>
                  <Icon name="download" />
                  Download PDF
                </a>
              </div>
            </div>
          </>
        ) : showPending ? (
          <div class="resume-placeholder">
            <PlaceholderNote label="Pending — dev only" title="Resume PDF not added yet">
              <p>Place the PDF in <code>public/resume/</code> and set <code>resume.pdf</code> in <code>src/config/site.ts</code>. This page will then show an inline viewer and a download button. Until then, the public page shows a short note and is excluded from search engines and the sitemap.</p>
            </PlaceholderNote>
          </div>
        ) : (
          <div class="resume-pending">
            <p>My resume isn’t posted here yet.</p>
            <p>
              In the meantime, the <a href={withBase('/projects/')}>projects</a> show the work in full, and the{' '}
              <a href={withBase('/contact/')}>contact page</a> lists where to reach me.
            </p>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .resume-updated {
    font-size: var(--text-sm);
    color: var(--on-dark-muted);
  }

  .resume-viewer {
    border: var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }

  .resume-viewer object {
    display: block;
    width: 100%;
    height: min(88vh, 72rem);
  }

  .resume-mobile {
    display: none;
    justify-items: start;
    gap: var(--space-2);
    padding: var(--space-6) var(--space-5);
    border: var(--border);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }

  .resume-mobile__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--space-2);
    border-radius: var(--radius);
    background: var(--orange-soft);
    color: var(--orange-text);
  }

  .resume-mobile__icon :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .resume-mobile__title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 800;
  }

  .resume-mobile__meta {
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .resume-mobile__actions {
    margin-top: var(--space-3);
    width: 100%;
  }

  .resume-mobile__actions .btn {
    flex: 1 1 12rem;
  }

  /* Phones and small tablets: actions instead of an embedded viewer. */
  @media (max-width: 47.99rem) {
    .resume-viewer {
      display: none;
    }

    .resume-mobile {
      display: grid;
    }
  }

  .resume-fallback {
    padding: var(--space-6);
  }

  .resume-fallback a {
    color: var(--accent-strong);
    font-weight: 600;
  }

  .resume-pending {
    display: grid;
    gap: var(--space-3);
    max-width: 38rem;
    font-size: var(--text-lg);
  }

  .resume-pending a {
    color: var(--orange-text);
    font-weight: 600;
  }

  .resume-placeholder {
    max-width: 40rem;
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.9em;
  }
</style>
