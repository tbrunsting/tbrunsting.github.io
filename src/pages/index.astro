---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroSports from '@/components/HeroSports.astro';
import FeaturedProject from '@/components/FeaturedProject.astro';
import ProjectGrid from '@/components/ProjectGrid.astro';
import SkillGroups from '@/components/SkillGroups.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import Icon, { type IconName } from '@/components/Icon.astro';
import { getProjects } from '@/lib/projects';
import { withBase } from '@/lib/paths';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const others = projects.filter((p) => !p.data.featured);
// If nothing is marked featured, promote the newest project.
const lead = featured.length > 0 ? featured : projects.slice(0, 1);
const rest = featured.length > 0 ? others : projects.slice(1);

const principles: { title: string; text: string; icon: IconName }[] = [
  {
    title: 'Verify before analysing',
    text: 'Sources are checked, frozen and documented before any result depends on them, so a finding can always be traced back to its data.',
    icon: 'shield-check',
  },
  {
    title: 'Decisions on the record',
    text: 'Judgement calls, rejected alternatives and known limitations are written down alongside the reasoning, not buried in code.',
    icon: 'ledger',
  },
  {
    title: 'Built to be read',
    text: 'Dashboards and case studies are designed for readers who want the answer and the confidence behind it.',
    icon: 'book',
  },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero surface-dark" aria-labelledby="hero-title">
    <HeroSports />
    <div class="container hero__inner">
      <div class="hero__copy">
        <p class="eyebrow">Sports Analytics</p>
        <h1 id="hero-title">Turning sports data into <span class="accent-word">insight.</span></h1>
        <p class="hero__lede">I build data-driven projects exploring questions across professional and collegiate sports.</p>
        <div class="btn-row hero__actions">
          <a class="btn btn--primary" href={withBase('/projects/')}>
            Explore Projects
            <Icon name="arrow-right" />
          </a>
          <a class="btn btn--ghost" href={withBase('/about/')}>About my approach</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured project -->
  <section class="section surface-light featured-section" aria-label="Featured project">
    <div class="container">
      {lead.map((project) => <FeaturedProject project={project} />)}

      {
        rest.length > 0 && (
          <div class="more-projects">
            <div class="more-projects__head">
              <h2 class="more-projects__title">More projects</h2>
              <a class="text-link" href={withBase('/projects/')}>
                All projects
                <Icon name="arrow-right" />
              </a>
            </div>
            <ProjectGrid projects={rest.slice(0, 6)} />
          </div>
        )
      }
    </div>
  </section>

  <!-- Analytics profile -->
  <section class="section surface-dark grid-texture profile-section" aria-labelledby="profile-title">
    <span class="profile-section__rule" aria-hidden="true"></span>
    <div class="container profile">
      <div class="profile__intro">
        <p class="eyebrow">Analytics profile</p>
        <h2 id="profile-title">Rigorous analysis, written for people who love the game.</h2>
        <p class="profile__text">
          Each project starts with a specific question and follows it end to end: sourcing and validating the data, designing the models, and presenting the results in a dashboard and a technical case study that explains both the answer and how much confidence it deserves.
        </p>
      </div>
      <ul class="principles" role="list">
        {
          principles.map((p) => (
            <li class="principle">
              <span class="principle__icon">
                <Icon name={p.icon} />
              </span>
              <div>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Tools & skills -->
  <section class="section surface-light" aria-labelledby="tools-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Tools & skills</p>
        <h2 id="tools-title">The working toolkit</h2>
        <p>The languages and platforms used across the current project work, from raw data to finished dashboard.</p>
      </div>
      <SkillGroups />
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    display: grid;
  }

  .hero :global(.hero-sports) {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: 55%;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    min-height: clamp(34rem, 78vh, 46rem);
    padding-block: var(--space-8);
  }

  .hero__copy {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
    max-width: 41rem;
  }

  .hero h1 {
    font-size: clamp(2.6rem, 1.3rem + 4.3vw, 4.7rem);
    font-weight: 850;
    line-height: 0.98;
    max-width: 16ch;
  }

  .hero__lede {
    max-width: 30rem;
    font-size: var(--text-lg);
    color: var(--on-dark-muted);
  }

  .hero__actions {
    margin-top: var(--space-2);
  }

  @media (max-width: 59.99rem) {
    .hero :global(.hero-sports) {
      position: relative;
      width: 100%;
      height: clamp(15rem, 52vw, 24rem);
    }

    .hero__inner {
      min-height: 0;
      padding-block: var(--space-2) var(--space-8);
      margin-top: calc(var(--space-6) * -1);
    }

    .hero__actions {
      width: 100%;
    }

    .hero__actions .btn {
      flex: 1 1 14rem;
    }
  }

  /* ---------- Featured ---------- */
  .more-projects {
    margin-top: var(--space-9);
  }

  .more-projects__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .more-projects__title {
    font-size: var(--text-2xl);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 700;
    font-size: var(--text-sm);
    color: var(--orange-text);
    text-decoration: none;
  }

  .text-link :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  /* ---------- Profile ---------- */
  .profile-section {
    overflow: hidden;
  }

  .profile-section__rule {
    position: absolute;
    top: -10%;
    bottom: -10%;
    left: clamp(0.5rem, 3vw, 3rem);
    width: 2px;
    background: linear-gradient(180deg, transparent, var(--orange) 30%, var(--orange) 60%, transparent);
    transform: rotate(18deg);
    transform-origin: top;
    opacity: 0.7;
    pointer-events: none;
  }

  .profile {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 60rem) {
    .profile {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: clamp(3rem, 2rem + 4vw, 6rem);
      align-items: center;
    }
  }

  .profile__intro {
    display: grid;
    gap: var(--space-5);
  }

  .profile__intro h2 {
    font-size: var(--text-3xl);
    max-width: 17ch;
  }

  .profile__text {
    color: var(--on-dark-muted);
    font-size: var(--text-lg);
    max-width: 34rem;
  }

  .principles {
    list-style: none;
    padding: 0;
  }

  .principle {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    padding-block: var(--space-5);
    border-top: 1px solid var(--border-dark);
  }

  .principle:last-child {
    border-bottom: 1px solid var(--border-dark);
  }

  .principle__icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1.5px solid var(--orange-line);
    border-radius: var(--radius);
    color: var(--orange);
  }

  .principle__icon :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }

  .principle h3 {
    font-size: var(--text-lg);
    font-weight: 750;
    letter-spacing: -0.01em;
    color: var(--on-dark);
  }

  .principle p {
    margin-top: var(--space-1);
    color: var(--on-dark-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }
</style>
