---
import BaseLayout from '@/layouts/BaseLayout.astro';
import FeaturedProject from '@/components/FeaturedProject.astro';
import ProjectGrid from '@/components/ProjectGrid.astro';
import SkillGroups from '@/components/SkillGroups.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import Icon from '@/components/Icon.astro';
import { getProjects } from '@/lib/projects';
import { withBase } from '@/lib/paths';

const projects = await getProjects();
const featured = projects.filter((p) => p.data.featured);
const others = projects.filter((p) => !p.data.featured);
// If nothing is marked featured, promote the newest project.
const lead = featured.length > 0 ? featured : projects.slice(0, 1);
const rest = featured.length > 0 ? others : projects.slice(1);

const principles = [
  {
    title: 'Verify before analysing',
    text: 'Sources are checked, frozen and documented before any result depends on them, so a finding can always be traced back to its data.',
  },
  {
    title: 'Decisions on the record',
    text: 'Judgement calls, rejected alternatives and known limitations are written down alongside the reasoning, not buried in code.',
  },
  {
    title: 'Built to be read',
    text: 'Dashboards and case studies are designed for readers who want the answer and the confidence behind it.',
  },
];
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero surface-darker" aria-labelledby="hero-title">
    <svg class="hero__field" viewBox="0 0 600 400" aria-hidden="true" focusable="false">
      <rect x="10" y="10" width="580" height="380" rx="3" />
      <line x1="300" y1="10" x2="300" y2="390" />
      <circle cx="300" cy="200" r="58" />
      <circle cx="300" cy="200" r="2.5" class="dot" />
      <rect x="10" y="110" width="92" height="180" />
      <rect x="10" y="160" width="32" height="80" />
      <rect x="498" y="110" width="92" height="180" />
      <rect x="558" y="160" width="32" height="80" />
    </svg>
    <div class="container hero__inner">
      <p class="eyebrow">Sports Analytics</p>
      <h1 id="hero-title">Turning sports data into insight.</h1>
      <p class="hero__lede">I build data-driven projects exploring questions across professional and collegiate sports.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href={withBase('/projects/')}>
          Explore Projects
          <Icon name="arrow-right" />
        </a>
        <a class="btn btn--ghost" href={withBase('/about/')}>About my approach</a>
      </div>
    </div>
  </section>

  <!-- Featured project -->
  <section class="section surface-light" aria-labelledby="featured-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Projects</p>
        <h2 id="featured-title">Featured work</h2>
      </div>

      <div class="featured-list">
        {lead.map((project) => <FeaturedProject project={project} />)}
      </div>

      {
        rest.length > 0 ? (
          <div class="more-projects">
            <div class="more-projects__head">
              <h2 class="more-projects__title">More projects</h2>
              <a class="text-link" href={withBase('/projects/')}>
                All projects
                <Icon name="arrow-right" />
              </a>
            </div>
            <ProjectGrid projects={rest.slice(0, 6)} />
          </div>
        ) : (
          <p class="coverage-note">
            Future projects will extend this work across college football, the NFL, MLB, the NBA and college basketball.
          </p>
        )
      }
    </div>
  </section>

  <!-- Analytics profile -->
  <section class="section surface-dark" aria-labelledby="profile-title">
    <div class="container profile">
      <div class="profile__intro">
        <p class="eyebrow">Analytics profile</p>
        <h2 id="profile-title">Rigorous analysis, written for people who love the game.</h2>
        <p class="profile__text">
          Each project starts with a specific question and follows it end to end: sourcing and validating the data, designing the models, and presenting the results in a dashboard and a technical case study that explains both the answer and how much confidence it deserves.
        </p>
      </div>
      <ol class="principles" role="list">
        {
          principles.map((p) => (
            <li class="principle">
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Tools & skills -->
  <section class="section surface-alt" aria-labelledby="tools-title">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Tools & skills</p>
        <h2 id="tools-title">The working toolkit</h2>
        <p>The languages and platforms used across the current project work, from raw data to finished dashboard.</p>
      </div>
      <SkillGroups />
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  /* Hero */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(4.5rem, 3rem + 7vw, 9rem) clamp(4rem, 3rem + 5vw, 7.5rem);
  }

  .hero__field {
    position: absolute;
    right: -8%;
    top: 50%;
    width: min(62rem, 95vw);
    transform: translateY(-50%) rotate(-8deg);
    fill: none;
    stroke: rgb(255 255 255 / 0.06);
    stroke-width: 1.4;
    pointer-events: none;
  }

  .hero__field .dot {
    fill: rgb(227 165 59 / 0.5);
    stroke: none;
  }

  .hero__inner {
    position: relative;
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .hero h1 {
    font-size: var(--text-4xl);
    font-weight: 800;
    letter-spacing: -0.03em;
    max-width: 14ch;
  }

  .hero__lede {
    max-width: 36rem;
    font-size: var(--text-lg);
    color: var(--on-dark-muted);
  }

  .hero .btn-row {
    margin-top: var(--space-3);
  }

  /* Featured */
  .featured-list {
    display: grid;
    gap: var(--space-6);
  }

  .coverage-note {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: var(--border);
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  .more-projects {
    margin-top: var(--space-8);
  }

  .more-projects__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
    margin-bottom: var(--space-5);
  }

  .more-projects__title {
    font-size: var(--text-2xl);
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--accent-strong);
    text-decoration: none;
  }

  .text-link :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  /* Profile */
  .profile {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 60rem) {
    .profile {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-8);
      align-items: start;
    }
  }

  .profile__intro {
    display: grid;
    gap: var(--space-4);
  }

  .profile__intro h2 {
    font-size: var(--text-3xl);
  }

  .profile__text {
    color: var(--on-dark-muted);
    font-size: var(--text-lg);
  }

  .principles {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0;
    counter-reset: principle;
  }

  .principle {
    padding-block: var(--space-5);
    border-top: 1px solid var(--border-dark);
    display: grid;
    gap: var(--space-2);
  }

  .principle:last-child {
    border-bottom: 1px solid var(--border-dark);
  }

  .principle h3 {
    font-size: var(--text-lg);
    color: var(--on-dark);
  }

  .principle h3::before {
    content: '';
    display: inline-block;
    width: 0.55rem;
    height: 0.55rem;
    margin-right: 0.7rem;
    background: var(--accent);
    border-radius: 2px;
    vertical-align: 0.12em;
  }

  .principle p {
    color: var(--on-dark-muted);
    font-size: var(--text-sm);
    padding-left: 1.25rem;
  }
</style>
