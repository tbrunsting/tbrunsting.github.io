---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ProjectHero from '@/components/ProjectHero.astro';
import DashboardPreview from '@/components/DashboardPreview.astro';
import DashboardEmbed from '@/components/DashboardEmbed.astro';
import ContactCTA from '@/components/ContactCTA.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import Icon from '@/components/Icon.astro';
import { mdxComponents } from '@/components/mdx';
import { getProjects, type Project } from '@/lib/projects';
import { withBase } from '@/lib/paths';
import '@/styles/prose.css';

export async function getStaticPaths() {
  const projects = await getProjects();
  const publicDir = join(process.cwd(), 'public');

  return projects.map((project) => {
    // Never reference a share image that doesn't exist.
    const og = project.data.ogImage;
    if (og && !existsSync(join(publicDir, og))) {
      throw new Error(
        `Project "${project.id}" sets ogImage "${og}", but public${og} does not exist. Add the file or remove the field.`,
      );
    }
    return { params: { slug: project.id }, props: { project } };
  });
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);

// A table of contents only earns its space on genuinely long case studies.
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = tocHeadings.filter((h) => h.depth === 2).length >= 4;
---

<BaseLayout
  title={data.title}
  description={data.summary}
  image={data.ogImage}
  imageAlt={data.ogImage ? (data.ogImageAlt ?? data.title) : undefined}
  type="article"
  publishedAt={data.publishedAt}
  updatedAt={data.updatedAt}
>
  <ProjectHero project={project} />

  <div class="surface-light">
   <div class:list={['container case-layout', { 'case-layout--toc': showToc }]}>
    {
      showToc && (
        <div class="case-toc">
          <TableOfContents headings={tocHeadings} />
        </div>
      )
    }
    <div class="case-main">
    <div class="project-dashboard">
      <DashboardPreview dashboard={data.dashboard} title={data.title} />
    </div>

    <article class="project-body" aria-label="Case study">
      <div class="prose">
        <Content components={mdxComponents} />
      </div>
    </article>

    {
      data.dashboard.embedUrl && (
        <div class="project-embed">
          <DashboardEmbed
            embedUrl={data.dashboard.embedUrl}
            url={data.dashboard.url}
            title={`${data.title} — interactive dashboard`}
            preview={data.dashboard.preview}
          />
        </div>
      )
    }

    <nav class="project-links" aria-label="Project links">
      {
        data.dashboard.url && (
          <a class="btn btn--primary" href={data.dashboard.url} target="_blank" rel="noopener">
            <Icon name="chart" />
            Explore interactive dashboard
            <Icon name="external" />
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        )
      }
      {
        data.githubUrl && (
          <a class="btn btn--dark" href={data.githubUrl} target="_blank" rel="noopener">
            <Icon name="github" />
            Full source code on GitHub
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        )
      }
      {
        data.downloads.map((file) => (
          <a class="btn btn--ghost" href={file.url} rel="noopener">
            <Icon name="download" />
            {file.label}
            {file.detail && <span class="visually-hidden">({file.detail})</span>}
          </a>
        ))
      }
      <a class="btn btn--ghost" href={withBase('/projects/')}>
        <Icon name="arrow-left" />
        All projects
      </a>
    </nav>
    </div>
   </div>
  </div>

  <ContactCTA />
</BaseLayout>

<style>
  /* Without a table of contents: the original centred 60rem column. */
  .case-main {
    max-width: var(--width-wide);
    margin-inline: auto;
  }

  /* With one: a sticky right-hand column on wide screens, and a sticky
     "Jump to section" bar above the content on narrower ones. */
  .case-layout--toc {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .case-layout--toc .case-main {
    max-width: none;
    margin-inline: 0;
  }

  .case-toc {
    position: sticky;
    top: var(--header-height);
    z-index: 20;
  }

  @media (min-width: 75rem) {
    .case-layout--toc {
      grid-template-columns: minmax(0, 1fr) 14.5rem;
      column-gap: clamp(2rem, 1rem + 2vw, 3.5rem);
      align-items: start;
    }

    /* The column spans the article's height; the list inside it is what sticks. */
    .case-toc {
      grid-column: 2;
      grid-row: 1;
      position: static;
      z-index: auto;
      align-self: stretch;
      padding-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
    }

    .case-layout--toc .case-main {
      grid-column: 1;
      grid-row: 1;
    }
  }

  /* Leave room for the sticky mobile bar when jumping to a heading. */
  @media (max-width: 74.99rem) {
    :global(html:has(.case-layout--toc)) {
      scroll-padding-top: calc(var(--header-height) + 4.25rem);
    }
  }

  .project-dashboard {
    padding-top: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }

  .project-body {
    padding-block: clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  .project-embed {
    padding-bottom: var(--space-8);
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    padding-top: var(--space-6);
    padding-bottom: var(--section-pad);
    border-top: var(--border);
  }

  @media (min-width: 64rem) {
    .project-links {
      border-top: 0;
    }
  }
</style>
