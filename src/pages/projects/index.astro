---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/PageHeader.astro';
import ProjectGrid from '@/components/ProjectGrid.astro';
import { getProjects } from '@/lib/projects';

const projects = await getProjects();
const countLabel = `${projects.length} ${projects.length === 1 ? 'project' : 'projects'}`;
// Sport filters are intentionally omitted until the collection covers more
// than one sport — a row of empty categories would be misleading.
---

<BaseLayout
  title="Projects"
  description="Sports analytics projects with dashboards and technical case studies."
>
  <PageHeader
    eyebrow="Projects"
    title="Analytical projects"
    lede="Exploring data-driven questions across professional and collegiate sports. Each project pairs a dashboard with a technical case study."
  />

  <section class="projects surface-dark" aria-labelledby="project-list-title">
    <div class="container">
      <div class="projects__head">
        <h2 id="project-list-title" class="visually-hidden">All projects</h2>
        <p class="projects__count">{countLabel}</p>
      </div>

      <ProjectGrid projects={projects} headingLevel="h3" layout="list" />

      {projects.length === 0 && <p class="projects__empty">Projects will appear here once they are added.</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .projects {
    padding-block: var(--space-4) var(--section-pad);
  }

  .projects__head {
    margin-bottom: var(--space-4);
  }

  .projects__count {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }

  .projects__empty {
    color: var(--on-dark-muted);
  }
</style>
