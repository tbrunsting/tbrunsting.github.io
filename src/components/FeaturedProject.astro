---
import ProjectMedia from './ProjectMedia.astro';
import ToolList from './ToolList.astro';
import Icon from './Icon.astro';
import { projectUrl, statusLabel, type Project } from '@/lib/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, sport, timePeriod, question, summary, tools, status, githubUrl } = project.data;
const href = projectUrl(project);
---

<article class="featured">
  <a class="featured__media" href={href} tabindex="-1" aria-hidden="true">
    <ProjectMedia project={project} sizes="(min-width: 64rem) 40rem, 100vw" eager />
  </a>

  <div class="featured__body">
    <p class="featured__meta">
      <span class="eyebrow">Featured project</span>
      {status !== 'published' && <span class="badge">{statusLabel[status]}</span>}
    </p>

    <h3 class="featured__title">
      <a href={href}>{title}</a>
    </h3>

    <p class="featured__context">{sport} · {timePeriod}</p>

    <blockquote class="featured__question">
      <p>{question}</p>
    </blockquote>

    <p class="featured__summary">{summary}</p>

    <ToolList tools={tools} size="sm" />

    <div class="btn-row featured__actions">
      <a class="btn btn--dark" href={href}>
        View Project
        <Icon name="arrow-right" />
      </a>
      {
        githubUrl && (
          <a class="btn btn--ghost" href={githubUrl} target="_blank" rel="noopener">
            <Icon name="github" />
            Source on GitHub
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .featured {
    display: grid;
    grid-template-columns: 1fr;
    background: var(--white);
    border: var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }

  @media (min-width: 60rem) {
    .featured {
      grid-template-columns: 1.15fr 1fr;
    }

    .featured__media :global(.project-media) {
      height: 100%;
      aspect-ratio: auto;
      min-height: 26rem;
    }
  }

  .featured__media {
    display: block;
  }

  .featured__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: clamp(1.5rem, 1rem + 2vw, 2.75rem);
  }

  .featured__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .featured__title {
    font-size: var(--text-3xl);
  }

  .featured__title a {
    text-decoration: none;
  }

  .featured__title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 3px;
  }

  .featured__context {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-muted);
    margin-top: calc(var(--space-2) * -1);
  }

  .featured__question {
    border-left: 3px solid var(--accent);
    padding-left: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 550;
    line-height: var(--leading-snug);
  }

  .featured__summary {
    color: var(--ink-muted);
  }

  .featured__actions {
    margin-top: var(--space-2);
  }
</style>
