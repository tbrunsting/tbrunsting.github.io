---
/**
 * Homepage "opening spread" for a featured project: editorial text on the
 * left, a large cinematic image (or, later, a dashboard screenshot) on the
 * right, and the verified scope statistics beneath.
 */
import ProjectMedia from './ProjectMedia.astro';
import ProjectStats from './ProjectStats.astro';
import ToolList from './ToolList.astro';
import Icon from './Icon.astro';
import { projectUrl, statusLabel, type Project } from '@/lib/projects';

interface Props {
  project: Project;
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel: Heading = 'h2' } = Astro.props;
const { title, sport, timePeriod, question, summary, tools, status, stats, githubUrl } = project.data;
const href = projectUrl(project);
---

<article class="feature">
  <div class="feature__text">
    <p class="eyebrow">Featured project</p>
    <Heading class="feature__title">
      <a href={href}>{title}</a>
    </Heading>
    <p class="feature__question">{question}</p>

    <ul class="feature__badges" aria-label="Project details">
      <li class="badge">{sport}</li>
      <li class="badge">{timePeriod}</li>
      {status !== 'published' && <li class="badge badge--accent">{statusLabel[status]}</li>}
    </ul>

    <p class="feature__summary">{summary}</p>
    <ToolList tools={tools} size="sm" />
  </div>

  <a class="feature__media" href={href} tabindex="-1" aria-hidden="true">
    <ProjectMedia project={project} sizes="(min-width: 64rem) 38rem, 100vw" />
  </a>

  <div class="feature__actions btn-row">
    <a class="btn btn--primary" href={href}>
      View Project
      <Icon name="arrow-right" />
    </a>
    {
      githubUrl && (
        <a class="btn btn--ghost" href={githubUrl} target="_blank" rel="noopener">
          <Icon name="github" />
          Source on GitHub
          <span class="visually-hidden">(opens in a new tab)</span>
        </a>
      )
    }
  </div>

  <ProjectStats stats={stats} tone="light" showNotes={false} class="feature__stats" />
</article>

<style>
  .feature {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas: 'text' 'media' 'actions' 'stats';
    gap: var(--space-6);
  }

  @media (min-width: 60rem) {
    .feature {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      grid-template-areas:
        'text media'
        'actions stats';
      column-gap: clamp(2.5rem, 1rem + 4vw, 5rem);
      row-gap: var(--space-7);
      align-items: center;
    }
  }

  .feature__text {
    grid-area: text;
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .feature__title {
    font-size: var(--text-3xl);
    margin-top: calc(var(--space-2) * -1);
  }

  .feature__title a {
    text-decoration: none;
  }

  .feature__title a:hover {
    text-decoration: underline;
    text-decoration-color: var(--orange);
    text-decoration-thickness: 3px;
    text-underline-offset: 0.12em;
  }

  .feature__question {
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--ink-muted);
    max-width: 34rem;
  }

  .feature__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    padding: 0;
  }

  .feature__summary {
    max-width: 34rem;
  }

  .feature__media {
    grid-area: media;
    display: block;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .feature__media :global(.project-media) {
    aspect-ratio: 4 / 3;
  }

  .feature__media :global(.project-media__img) {
    filter: brightness(0.88) contrast(1.08) saturate(0.9);
  }

  .feature__media:hover :global(.project-media__img) {
    transform: scale(1.03);
  }

  .feature__actions {
    grid-area: actions;
    align-self: center;
  }

  .feature :global(.feature__stats) {
    grid-area: stats;
  }
</style>
