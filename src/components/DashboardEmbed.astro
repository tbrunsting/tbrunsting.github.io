---
/**
 * Responsive Power BI (or other) dashboard embed.
 *
 * Renders nothing at all unless `embedUrl` is provided — never an empty iframe.
 * Wide screens get the live iframe. Narrow screens get the preview image (if
 * any) and an "Open Interactive Dashboard" link instead, because a complex
 * dashboard squeezed into a phone-width iframe is unusable. The switch is pure
 * CSS (media queries), no viewport-detection JavaScript.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { ImageMetadata } from 'astro';

interface Props {
  embedUrl?: string;
  /** Link to open the dashboard in a new tab (used on small screens). */
  url?: string;
  /** Accessible title for the iframe, e.g. 'Transfer Market Efficiency dashboard'. */
  title: string;
  preview?: { src: ImageMetadata; alt: string };
  /** Width / height of the report page. Power BI's default page is 16:9. */
  aspectRatio?: string;
  heading?: string;
}

const {
  embedUrl,
  url,
  title,
  preview,
  aspectRatio = '16 / 9',
  heading = 'Explore the interactive dashboard',
} = Astro.props;
const openUrl = url ?? embedUrl;
---

{
  embedUrl && (
    <section class="dashboard-embed" aria-label={heading}>
      <h2 class="dashboard-embed__heading">{heading}</h2>

      <div class="dashboard-embed__frame" style={`aspect-ratio: ${aspectRatio}`}>
        <iframe
          src={embedUrl}
          title={title}
          loading="lazy"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        />
      </div>

      <div class="dashboard-embed__mobile">
        {preview && (
          <Image src={preview.src} alt={preview.alt} widths={[480, 800]} sizes="100vw" class="dashboard-embed__preview" />
        )}
        <p>The interactive dashboard is designed for larger screens.</p>
        {openUrl && (
          <a class="btn btn--dark" href={openUrl} target="_blank" rel="noopener">
            Open Interactive Dashboard
            <Icon name="external" />
            <span class="visually-hidden">(opens in a new tab)</span>
          </a>
        )}
      </div>
    </section>
  )
}

<style>
  .dashboard-embed {
    display: grid;
    gap: var(--space-4);
  }

  .dashboard-embed__heading {
    font-size: var(--text-2xl);
  }

  .dashboard-embed__frame {
    display: none;
    width: 100%;
    border: var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--white);
    box-shadow: var(--shadow);
  }

  .dashboard-embed__frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }

  .dashboard-embed__mobile {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding: var(--space-5);
    border: var(--border);
    border-radius: var(--radius-lg);
    background: var(--white);
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  .dashboard-embed__preview {
    border-radius: var(--radius);
    border: var(--border);
  }

  @media (min-width: 64rem) {
    .dashboard-embed__frame {
      display: block;
    }

    .dashboard-embed__mobile {
      display: none;
    }
  }
</style>
