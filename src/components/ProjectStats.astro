---
/** Row of verified, project-specific headline figures. Renders nothing if empty. */
interface Stat {
  label: string;
  value: string;
  note?: string;
}

interface Props {
  stats: readonly Stat[];
  caption?: string;
}

const { stats, caption } = Astro.props;
---

{
  stats.length > 0 && (
    <figure class="project-stats">
      <dl class="project-stats__list">
        {stats.map((stat) => (
          <div class="project-stats__item">
            <dt>{stat.label}</dt>
            <dd>
              <span class="project-stats__value">{stat.value}</span>
              {stat.note && <span class="project-stats__note">{stat.note}</span>}
            </dd>
          </div>
        ))}
      </dl>
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  )
}

<style>
  .project-stats__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9.5rem), 1fr));
    border-top: 1px solid var(--border-dark);
  }

  .project-stats__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-5) var(--space-4) var(--space-4) 0;
    border-bottom: 1px solid var(--border-dark);
  }

  dt {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }

  dd {
    display: grid;
    gap: 0.1rem;
  }

  .project-stats__value {
    font-family: var(--font-display);
    font-weight: 750;
    font-size: var(--text-2xl);
    line-height: 1.1;
    color: var(--on-dark);
    font-variant-numeric: tabular-nums;
  }

  .project-stats__note {
    font-size: var(--text-xs);
    color: var(--on-dark-muted);
  }

  figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--on-dark-muted);
  }
</style>
