---
/**
 * Row of verified, project-specific headline figures, separated by thin
 * vertical rules. Renders nothing if empty.
 */
interface Stat {
  label: string;
  value: string;
  note?: string;
}

interface Props {
  stats: readonly Stat[];
  /** 'dark' on charcoal heroes, 'light' on warm white. */
  tone?: 'dark' | 'light';
  /** Show the optional explanatory note under each label. */
  showNotes?: boolean;
  caption?: string;
  class?: string;
}

const { stats, tone = 'dark', showNotes = true, caption, class: className } = Astro.props;
---

{
  stats.length > 0 && (
    <figure class:list={['project-stats', `project-stats--${tone}`, className]}>
      <dl class="project-stats__list">
        {stats.map((stat) => (
          <div class="project-stats__item">
            <dt>{stat.label}</dt>
            <dd class="project-stats__value">{stat.value}</dd>
            {showNotes && stat.note && <dd class="project-stats__note">{stat.note}</dd>}
          </div>
        ))}
      </dl>
      {caption && <figcaption>{caption}</figcaption>}
    </figure>
  )
}

<style>
  .project-stats {
    --rule: var(--border-dark);
    --label: var(--on-dark-muted);
    --value: var(--on-dark);
  }

  .project-stats--light {
    --rule: var(--gray-200);
    --label: var(--ink-muted);
    --value: var(--ink);
  }

  .project-stats__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 8rem), 1fr));
  }

  .project-stats__item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: var(--space-2) var(--space-5);
    border-left: 1px solid var(--rule);
  }

  /* Value above label visually; the label stays first for screen readers. */
  dt {
    order: 2;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--label);
  }

  .project-stats__value {
    order: 1;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-2xl);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--value);
    font-variant-numeric: tabular-nums;
  }

  .project-stats__note {
    order: 3;
    font-size: var(--text-xs);
    line-height: 1.45;
    color: var(--label);
    opacity: 0.85;
  }

  @media (max-width: 36rem) {
    .project-stats__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--space-4);
    }

    .project-stats__item {
      padding-inline: var(--space-4);
    }
  }

  figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    color: var(--label);
  }
</style>
