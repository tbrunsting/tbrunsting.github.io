---
/**
 * Project list. 'grid' lays out stacked cards; 'list' stacks wide editorial
 * cards (Projects page). Renders nothing when there are no projects.
 */
import ProjectCard from './ProjectCard.astro';
import type { Project } from '@/lib/projects';

interface Props {
  projects: Project[];
  headingLevel?: 'h2' | 'h3';
  layout?: 'grid' | 'list';
}

const { projects, headingLevel = 'h3', layout = 'grid' } = Astro.props;
---

{
  projects.length > 0 && (
    <ul class:list={['project-grid', `project-grid--${layout}`]} role="list">
      {projects.map((project) => (
        <li>
          <ProjectCard project={project} headingLevel={headingLevel} variant={layout === 'list' ? 'wide' : 'stacked'} />
        </li>
      ))}
    </ul>
  )
}

<style>
  .project-grid {
    display: grid;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
  }

  .project-grid--grid {
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
  }

  .project-grid--list {
    grid-template-columns: 1fr;
  }
</style>
