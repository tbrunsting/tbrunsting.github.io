---
/**
 * Visual for project cards and the featured project.
 * Priority: real dashboard screenshot → thumbnail photo → neutral branded cover.
 * The cover never imitates a dashboard or shows data.
 */
import { Image } from 'astro:assets';
import type { Project } from '@/lib/projects';

interface Props {
  project: Project;
  sizes?: string;
  eager?: boolean;
}

const { project, sizes = '(min-width: 64rem) 36rem, 100vw', eager = false } = Astro.props;
const { dashboard, thumbnail, sport } = project.data;
const media = dashboard.preview ?? thumbnail;
const position = media && 'position' in media ? media.position : undefined;
---

<div class="project-media">
  {
    media ? (
      <Image
        src={media.src}
        alt={media.alt}
        widths={[480, 800, 1200, 1600]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        class="project-media__img"
        style={position ? `object-position: ${position}` : undefined}
      />
    ) : (
      <div class="project-media__cover">
        <svg class="project-media__lines" viewBox="0 0 400 250" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
          <line x1="250" y1="-10" x2="170" y2="260" class="accent" />
          <line x1="300" y1="-10" x2="220" y2="260" />
        </svg>
        <span class="project-media__sport">{sport}</span>
      </div>
    )
  }
</div>

<style>
  .project-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--charcoal);
  }

  .project-media__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease);
  }

  .project-media__cover {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: var(--space-5);
    background:
      radial-gradient(120% 90% at 100% 0%, rgb(255 112 73 / 0.14), transparent 60%),
      linear-gradient(160deg, var(--charcoal-2), var(--charcoal-950));
  }

  .project-media__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: rgb(255 255 255 / 0.08);
    stroke-width: 1.5;
  }

  .project-media__lines .accent {
    stroke: var(--orange-line);
  }

  .project-media__sport {
    position: relative;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }
</style>
