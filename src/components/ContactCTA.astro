---
import { withBase } from '@/lib/paths';
import Icon from './Icon.astro';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Questions about a project?',
  text = 'I’m always glad to talk through methodology, data sources or ideas for new sports analytics questions.',
} = Astro.props;
---

<section class="contact-cta surface-dark section" aria-labelledby="contact-cta-title">
  <div class="container contact-cta__inner">
    <div>
      <p class="eyebrow">Contact</p>
      <h2 id="contact-cta-title">{title}</h2>
      <p class="contact-cta__text">{text}</p>
    </div>
    <div class="btn-row">
      <a class="btn btn--primary" href={withBase('/contact/')}>
        Get in touch
        <Icon name="arrow-right" />
      </a>
    </div>
  </div>
</section>

<style>
  .contact-cta__inner {
    display: grid;
    gap: var(--space-6);
    align-items: end;
  }

  @media (min-width: 52rem) {
    .contact-cta__inner {
      grid-template-columns: 1fr auto;
    }
  }

  h2 {
    font-size: var(--text-3xl);
    margin-top: var(--space-3);
  }

  .contact-cta__text {
    margin-top: var(--space-3);
    max-width: 36rem;
    color: var(--on-dark-muted);
    font-size: var(--text-lg);
  }
</style>
