---
/** Concise editorial call to action on a dark band. */
import { withBase } from '@/lib/paths';
import Icon from './Icon.astro';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Let’s turn a sports question into a project.',
  text = 'Questions about methodology, data sources or new ideas for sports analytics are always welcome.',
} = Astro.props;
---

<section class="cta surface-darker" aria-labelledby="cta-title">
  <div class="container cta__inner">
    <div class="cta__copy">
      <h2 id="cta-title">{title}</h2>
      <p>{text}</p>
    </div>
    <a class="btn btn--primary" href={withBase('/contact/')}>
      Get in touch
      <Icon name="arrow-right" />
    </a>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.75rem, 2rem + 3vw, 4.25rem);
    border-top: 1px solid var(--border-dark);
  }

  /* Thin diagonal orange rule */
  .cta::after {
    content: '';
    position: absolute;
    top: -20%;
    bottom: -20%;
    right: 12%;
    width: 2px;
    background: var(--orange-line);
    transform: rotate(24deg);
    pointer-events: none;
  }

  .cta__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  @media (min-width: 52rem) {
    .cta__inner {
      grid-template-columns: 1fr auto;
      gap: var(--space-7);
    }
  }

  .cta__copy {
    display: grid;
    gap: var(--space-2);
  }

  h2 {
    font-size: var(--text-2xl);
  }

  p {
    color: var(--on-dark-muted);
    max-width: 38rem;
  }
</style>
