---
/**
 * Dashboard preview near the top of a project page.
 *  - With a real screenshot: shows it (linked to the live dashboard if a URL exists).
 *  - Without one: shows a clearly labelled temporary placeholder — never a mock-up.
 */
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { Project } from '@/lib/projects';

interface Props {
  dashboard: Project['data']['dashboard'];
  title: string;
}

const { dashboard, title } = Astro.props;
const { preview, url, note, status } = dashboard;
---

<section class="dashboard-preview" aria-labelledby="dashboard-preview-title">
  <div class="dashboard-preview__head">
    <h2 id="dashboard-preview-title" class="dashboard-preview__title">
      <Icon name="chart" />
      Dashboard
    </h2>
    {
      url && (
        <a class="btn btn--dark" href={url} target="_blank" rel="noopener">
          Explore interactive dashboard
          <Icon name="external" />
          <span class="visually-hidden">(opens in a new tab)</span>
        </a>
      )
    }
  </div>

  {
    preview ? (
      <figure class="dashboard-preview__figure">
        <Image
          src={preview.src}
          alt={preview.alt}
          widths={[640, 1000, 1400, 1920]}
          sizes="(min-width: 76rem) 72rem, 100vw"
          loading="eager"
        />
        {note && <figcaption>{note}</figcaption>}
      </figure>
    ) : (
      <div class="placeholder dashboard-preview__placeholder" role="note">
        <span class="dashboard-preview__icon" aria-hidden="true">
          <Icon name="chart" />
        </span>
        <p class="dashboard-preview__label">Temporary placeholder</p>
        <p class="dashboard-preview__heading">
          {status === 'in-development' ? 'Interactive dashboard in development' : 'Dashboard preview coming soon'}
        </p>
        <p class="dashboard-preview__text">
          {note ??
            `The Power BI dashboard for ${title} is being polished. A real preview and an interactive version will be added here once it is ready for public presentation.`}
        </p>
      </div>
    )
  }
</section>

<style>
  .dashboard-preview {
    display: grid;
    gap: var(--space-4);
  }

  .dashboard-preview__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .dashboard-preview__title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-family: var(--font-body);
    font-weight: 650;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .dashboard-preview__title :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    color: var(--accent-strong);
  }

  .dashboard-preview__figure {
    border: var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--white);
    box-shadow: var(--shadow);
  }

  .dashboard-preview__figure :global(img) {
    width: 100%;
  }

  .dashboard-preview__figure figcaption {
    padding: var(--space-3) var(--space-4);
    border-top: var(--border);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .dashboard-preview__placeholder {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-2);
    padding: clamp(2.5rem, 2rem + 4vw, 4.5rem) var(--space-5);
    background-color: var(--white);
    border-radius: var(--radius-lg);
  }

  .dashboard-preview__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--space-2);
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .dashboard-preview__icon :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }

  .dashboard-preview__label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--gray-500);
  }

  .dashboard-preview__heading {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
  }

  .dashboard-preview__text {
    max-width: 34rem;
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }
</style>
