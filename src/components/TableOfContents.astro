---
/**
 * Table of contents for long-form case studies, generated from the article's
 * real headings (h2, with h3 nested beneath).
 *
 *  - Wide screens: a sticky list in the right-hand column (.toc-desktop).
 *  - Narrow screens: a compact sticky "Jump to section" disclosure (.toc-mobile)
 *    that also shows the current section.
 *
 * Both are plain links and native <details>, so they work with the keyboard and
 * without JavaScript. A small script adds active-section highlighting
 * (aria-current) and closes the mobile menu after a jump. Smooth scrolling and
 * the header offset come from global CSS (scroll-behavior, scroll-padding-top),
 * and respect reduced-motion preferences.
 */
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
  title?: string;
}

const { headings, title = 'On this page' } = Astro.props;

interface Entry {
  slug: string;
  text: string;
  children: { slug: string; text: string }[];
}

const entries: Entry[] = [];
for (const h of headings) {
  if (h.depth === 2) entries.push({ slug: h.slug, text: h.text, children: [] });
  else if (h.depth === 3 && entries.length) entries.at(-1)!.children.push({ slug: h.slug, text: h.text });
}
---

{
  entries.length > 0 && (
    <>
      <nav class="toc toc-desktop" aria-label={title} data-toc>
        <p class="toc__title">{title}</p>
        <ol class="toc__list">
          {entries.map((e) => (
            <li>
              <a href={`#${e.slug}`} data-toc-link={e.slug}>
                {e.text}
              </a>
              {e.children.length > 0 && (
                <ol class="toc__sub">
                  {e.children.map((c) => (
                    <li>
                      <a href={`#${c.slug}`} data-toc-link={c.slug}>
                        {c.text}
                      </a>
                    </li>
                  ))}
                </ol>
              )}
            </li>
          ))}
        </ol>
      </nav>

      <nav class="toc-mobile" aria-label={title} data-toc>
        <details class="toc-mobile__details" data-toc-details>
          <summary class="toc-mobile__summary">
            <span class="toc-mobile__label">Jump to section</span>
            <span class="toc-mobile__current" data-toc-current aria-hidden="true" />
          </summary>
          <ol class="toc__list toc-mobile__list">
            {entries.map((e) => (
              <li>
                <a href={`#${e.slug}`} data-toc-link={e.slug}>
                  {e.text}
                </a>
                {e.children.length > 0 && (
                  <ol class="toc__sub">
                    {e.children.map((c) => (
                      <li>
                        <a href={`#${c.slug}`} data-toc-link={c.slug}>
                          {c.text}
                        </a>
                      </li>
                    ))}
                  </ol>
                )}
              </li>
            ))}
          </ol>
        </details>
      </nav>
    </>
  )
}

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const slugs = [...new Set(links.map((a) => a.dataset.tocLink!))];
  const headings = slugs.map((s) => document.getElementById(s)).filter((h): h is HTMLElement => !!h);
  const currentLabel = document.querySelector<HTMLElement>('[data-toc-current]');
  const details = document.querySelector<HTMLDetailsElement>('[data-toc-details]');

  if (headings.length) {
    let active = '';

    const setActive = (slug: string) => {
      if (slug === active) return;
      active = slug;
      for (const a of links) {
        if (a.dataset.tocLink === slug) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      }
      if (currentLabel) {
        const h = headings.find((x) => x.id === slug);
        currentLabel.textContent = h ? h.textContent ?? '' : '';
      }
      // Keep the active entry visible inside the desktop list when it scrolls,
      // adjusting only the list's own scroll position, never the page's.
      const list = document.querySelector<HTMLElement>('.toc-desktop');
      const link = list?.querySelector<HTMLElement>(`[data-toc-link="${slug}"]`);
      if (list && link && list.scrollHeight > list.clientHeight) {
        const top = link.getBoundingClientRect().top - list.getBoundingClientRect().top + list.scrollTop;
        if (top < list.scrollTop || top + link.offsetHeight > list.scrollTop + list.clientHeight) {
          list.scrollTop = Math.max(0, top - list.clientHeight / 3);
        }
      }
    };

    // The active section is the last heading that has scrolled past the
    // sticky header (read from the page's own scroll-padding-top).
    const update = () => {
      const offset = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
      let current = '';
      for (const h of headings) {
        if (h.getBoundingClientRect().top - offset <= 8) current = h.id;
        else break;
      }
      setActive(current);
    };

    let queued = false;
    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    };

    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    update();

    // Mark the target immediately on click, and close the mobile menu.
    for (const a of links) {
      a.addEventListener('click', () => {
        if (details) details.open = false;
        setActive(a.dataset.tocLink!);
      });
    }

    // Escape closes the mobile menu and returns focus to its toggle.
    details?.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && details.open) {
        details.open = false;
        details.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  /* ---------- Shared list styling ---------- */
  .toc__list,
  .toc__sub {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc__list a {
    display: block;
    padding: 0.3rem 0 0.3rem 0.9rem;
    border-left: 2px solid var(--gray-200);
    font-size: var(--text-sm);
    line-height: 1.4;
    color: var(--ink-muted);
    text-decoration: none;
    transition:
      color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .toc__list > li > a {
    font-weight: 600;
  }

  .toc__sub a {
    padding-left: 1.75rem;
    font-size: 0.8125rem;
    font-weight: 450;
  }

  .toc__list a:hover {
    color: var(--ink);
    border-left-color: var(--gray-400);
  }

  .toc__list a[aria-current='true'] {
    color: var(--orange-text);
    border-left-color: var(--orange);
    font-weight: 700;
  }

  /* ---------- Desktop: sticky right-hand column ---------- */
  .toc-desktop {
    display: none;
  }

  .toc__title {
    margin-bottom: var(--space-3);
    font-size: var(--text-xs);
    font-weight: 750;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--orange-text);
  }

  @media (min-width: 75rem) {
    .toc-desktop {
      display: block;
      position: sticky;
      top: calc(var(--header-height) + var(--space-5));
      max-height: calc(100vh - var(--header-height) - var(--space-7));
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: var(--space-2) var(--space-1) var(--space-2) 0;
      scrollbar-width: thin;
    }

    .toc-mobile {
      display: none;
    }
  }

  /* ---------- Mobile / tablet: compact sticky disclosure ---------- */
  .toc-mobile {
    position: sticky;
    top: var(--header-height);
    z-index: 20;
    margin-inline: calc(var(--gutter) * -1);
    padding: var(--space-2) var(--gutter);
    background: color-mix(in srgb, var(--paper) 94%, transparent);
    backdrop-filter: blur(6px);
    border-bottom: var(--border);
  }

  .toc-mobile__summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: 2.75rem;
    cursor: pointer;
    list-style: none;
    font-size: var(--text-sm);
  }

  .toc-mobile__summary::-webkit-details-marker {
    display: none;
  }

  .toc-mobile__summary::after {
    content: '';
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    margin-left: auto;
    border-right: 2px solid var(--orange-text);
    border-bottom: 2px solid var(--orange-text);
    transform: translateY(-25%) rotate(45deg);
    transition: transform var(--duration) var(--ease);
  }

  .toc-mobile__details[open] .toc-mobile__summary::after {
    transform: translateY(25%) rotate(-135deg);
  }

  .toc-mobile__label {
    flex: none;
    font-weight: 750;
    color: var(--ink);
  }

  .toc-mobile__current {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--ink-muted);
  }

  .toc-mobile__current:not(:empty)::before {
    content: '·';
    margin-right: var(--space-2);
    color: var(--gray-400);
  }

  .toc-mobile__list {
    max-height: min(60vh, 26rem);
    overflow-y: auto;
    padding-block: var(--space-2) var(--space-3);
  }
</style>
