---
/** A compact list of tools/technologies. */
interface Props {
  tools: readonly string[];
  label?: string;
  size?: 'sm' | 'md';
}

const { tools, label = 'Tools', size = 'md' } = Astro.props;
---

{
  tools.length > 0 && (
    <ul class:list={['tool-list', `tool-list--${size}`]} aria-label={label}>
      {tools.map((tool) => (
        <li>{tool}</li>
      ))}
    </ul>
  )
}

<style>
  .tool-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
  }

  /* Colours come from inherited --pill-* variables (see global.css), so the
     nearest surface — dark section or light card — decides the look. */
  .tool-list li {
    padding: 0.2rem 0.65rem;
    border: 1px solid var(--pill-border);
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 550;
    color: var(--pill-fg);
    background: var(--pill-bg);
    line-height: 1.6;
  }

  .tool-list--md li {
    font-size: var(--text-sm);
    padding: 0.25rem 0.75rem;
  }
</style>
