---
/** A compact list of tools/technologies. */
interface Props {
  tools: readonly string[];
  label?: string;
  size?: 'sm' | 'md';
}

const { tools, label = 'Tools', size = 'md' } = Astro.props;
---

{
  tools.length > 0 && (
    <ul class:list={['tool-list', `tool-list--${size}`]} aria-label={label}>
      {tools.map((tool) => (
        <li>{tool}</li>
      ))}
    </ul>
  )
}

<style>
  .tool-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
  }

  .tool-list li {
    padding: 0.2rem 0.6rem;
    border: var(--border);
    border-radius: 999px;
    font-size: var(--text-xs);
    font-weight: 550;
    color: var(--ink-muted);
    background: var(--white);
    line-height: 1.6;
  }

  .tool-list--md li {
    font-size: var(--text-sm);
    padding: 0.25rem 0.75rem;
  }

  :global(.surface-dark) .tool-list li,
  :global(.surface-darker) .tool-list li {
    border-color: var(--border-dark);
    background: rgb(255 255 255 / 0.04);
    color: var(--on-dark-muted);
  }
</style>
