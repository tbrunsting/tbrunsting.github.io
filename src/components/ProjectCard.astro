---
import ProjectMedia from './ProjectMedia.astro';
import ToolList from './ToolList.astro';
import Icon from './Icon.astro';
import { projectUrl, statusLabel, type Project } from '@/lib/projects';

interface Props {
  project: Project;
  headingLevel?: 'h2' | 'h3';
}

const { project, headingLevel: Heading = 'h3' } = Astro.props;
const { title, sport, timePeriod, summary, tools, status } = project.data;
const href = projectUrl(project);
---

<article class="project-card">
  <ProjectMedia project={project} sizes="(min-width: 64rem) 24rem, (min-width: 40rem) 50vw, 100vw" />
  <div class="project-card__body">
    <p class="project-card__meta">
      <span>{sport}</span>
      <span aria-hidden="true">·</span>
      <span>{timePeriod}</span>
      {status !== 'published' && <span class="badge project-card__status">{statusLabel[status]}</span>}
    </p>
    <Heading class="project-card__title">
      <a href={href}>{title}</a>
    </Heading>
    <p class="project-card__summary">{summary}</p>
    <ToolList tools={tools} size="sm" />
    <span class="project-card__cta" aria-hidden="true">
      View Project
      <Icon name="arrow-right" />
    </span>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--white);
    border: var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition:
      border-color var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }

  .project-card:hover,
  .project-card:focus-within {
    border-color: var(--gray-400);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  .project-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
    padding: var(--space-5);
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent-strong);
  }

  .project-card__status {
    margin-left: auto;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .project-card__title {
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .project-card__title a {
    text-decoration: none;
  }

  /* Stretch the single link across the whole card. */
  .project-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .project-card__title a:focus-visible {
    outline: none;
  }

  .project-card:has(.project-card__title a:focus-visible) {
    outline: 2px solid var(--accent-strong);
    outline-offset: 3px;
  }

  .project-card__summary {
    color: var(--ink-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
  }

  .project-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 650;
    color: var(--ink);
  }

  .project-card__cta :global(svg) {
    width: 1rem;
    height: 1rem;
    transition: transform var(--duration) var(--ease);
  }

  .project-card:hover .project-card__cta :global(svg) {
    transform: translateX(3px);
  }
</style>
