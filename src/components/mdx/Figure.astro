---
/**
 * Optimised project image (chart, screenshot, diagram) with a caption.
 *
 * MDX usage:
 *   import chart from '../../assets/projects/my-project/chart.png';
 *   <Figure src={chart} alt="Describe what the chart shows" caption="..." wide />
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Break out to the wider column (default true for images). */
  wide?: boolean;
  /** Optional source credit, shown after the caption. */
  credit?: string;
}

const { src, alt, caption, wide = true, credit } = Astro.props;
---

<figure class:list={['figure', { wide }]}>
  <Image src={src} alt={alt} widths={[640, 960, 1280, 1920]} sizes="(min-width: 64rem) 60rem, 100vw" />
  {
    (caption || credit) && (
      <figcaption>
        {caption}
        {credit && <span class="figure__credit">{credit}</span>}
      </figcaption>
    )
  }
</figure>

<style>
  .figure :global(img) {
    width: 100%;
    border: var(--border);
    border-radius: var(--radius);
    background: var(--white);
  }

  figcaption {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: 1.55;
  }

  .figure__credit {
    display: block;
    margin-top: 0.2rem;
    font-size: var(--text-xs);
  }
</style>
