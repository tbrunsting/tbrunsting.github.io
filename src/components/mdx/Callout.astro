---
/**
 * Highlighted aside for the reader.
 * Types: note | validation | limitation | decision | warning
 *
 * MDX usage:
 *   <Callout type="limitation" title="Undisclosed fees">
 *     Transfers with undisclosed fees are counted but never valued.
 *   </Callout>
 */
import Icon, { type IconName } from '../Icon.astro';

interface Props {
  type?: 'note' | 'validation' | 'limitation' | 'decision' | 'warning';
  title?: string;
}

const { type = 'note', title } = Astro.props;

const kinds: Record<NonNullable<Props['type']>, { label: string; icon: IconName }> = {
  note: { label: 'Note', icon: 'info' },
  validation: { label: 'Validation', icon: 'check' },
  limitation: { label: 'Limitation', icon: 'alert' },
  decision: { label: 'Methodological decision', icon: 'compass' },
  warning: { label: 'Caution', icon: 'alert' },
};
const kind = kinds[type];
---

<aside class:list={['callout', `callout--${type}`]} aria-label={title ?? kind.label}>
  <span class="callout__icon">
    <Icon name={kind.icon} />
  </span>
  <div class="callout__content">
    <p class="callout__kind">{kind.label}</p>
    {title && <p class="callout__title">{title}</p>}
    <div class="callout__body">
      <slot />
    </div>
  </div>
</aside>

<style>
  .callout {
    --c: var(--info);
    --c-soft: var(--info-soft);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--space-4);
    padding: var(--space-5);
    border-radius: var(--radius);
    border: 1px solid color-mix(in srgb, var(--c) 20%, transparent);
    border-left: 3px solid var(--c);
    background: var(--c-soft);
  }

  .callout--validation {
    --c: var(--success);
    --c-soft: var(--success-soft);
  }

  .callout--limitation {
    --c: var(--warning);
    --c-soft: var(--warning-soft);
  }

  .callout--decision {
    --c: var(--orange-text);
    --c-soft: #fff0ea;
  }

  .callout--warning {
    --c: var(--caution);
    --c-soft: var(--caution-soft);
  }

  .callout__icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--c) 12%, white);
    color: var(--c);
  }

  .callout__icon :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }

  .callout__content {
    min-width: 0;
  }

  .callout__kind {
    font-size: var(--text-xs);
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--c);
  }

  .callout__title {
    margin-top: var(--space-1);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    color: var(--ink);
  }

  .callout__body {
    margin-top: var(--space-2);
    font-size: 0.975rem;
    line-height: 1.65;
  }

  .callout__body :global(> * + *) {
    margin-top: 0.75em;
  }

  @media (max-width: 30rem) {
    .callout {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
  }
</style>
