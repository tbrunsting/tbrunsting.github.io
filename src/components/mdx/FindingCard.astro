---
/**
 * A single key finding, optionally with a headline figure.
 * Group several inside <FindingGrid>. Use only verified results.
 *
 * MDX usage:
 *   <FindingGrid>
 *     <FindingCard title="..." metric="+12%" metricLabel="...">Explanation.</FindingCard>
 *   </FindingGrid>
 */
import Icon from '../Icon.astro';

interface Props {
  title: string;
  metric?: string;
  metricLabel?: string;
}

const { title, metric, metricLabel } = Astro.props;
---

<article class="finding-card">
  <div class="finding-card__head">
    <span class="finding-card__icon" aria-hidden="true">
      <Icon name={metric ? 'chart' : 'lightbulb'} />
    </span>
    {
      metric && (
        <p class="finding-card__metric">
          <span class="finding-card__value">{metric}</span>
          {metricLabel && <span class="finding-card__metric-label">{metricLabel}</span>}
        </p>
      )
    }
  </div>
  <h3 class="finding-card__title">{title}</h3>
  <div class="finding-card__body">
    <slot />
  </div>
</article>

<style>
  .finding-card {
    display: grid;
    align-content: start;
    gap: var(--space-3);
    padding: var(--space-5);
    border: var(--border);
    border-top: 3px solid var(--orange);
    border-radius: var(--radius);
    background: var(--white);
    margin: 0 !important;
  }

  .finding-card__head {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .finding-card__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: var(--radius-sm);
    background: var(--orange-soft);
    color: var(--orange-text);
  }

  .finding-card__icon :global(svg) {
    width: 1.2rem;
    height: 1.2rem;
  }

  .finding-card__metric {
    display: grid;
    gap: 0.1rem;
  }

  .finding-card__value {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 850;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .finding-card__metric-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .finding-card__title {
    font-size: var(--text-lg);
    line-height: var(--leading-snug);
    margin: 0 !important;
  }

  .finding-card__title::before {
    display: none !important;
  }

  .finding-card__body {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: 1.6;
  }

  .finding-card__body :global(> * + *) {
    margin-top: 0.6em;
  }
</style>
