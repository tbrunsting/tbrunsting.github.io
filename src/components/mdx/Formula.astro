---
/**
 * LaTeX formula rendered to HTML + MathML at build time with KaTeX.
 * No client-side JavaScript. Wide equations scroll horizontally.
 *
 * MDX usage:
 *   <Formula tex="z = \frac{x - \mu}{\sigma}" label="Standard score">
 *     Where μ and σ are the mean and standard deviation within the season.
 *   </Formula>
 *   Inline: <Formula inline tex="\sigma" />
 */
import katex from 'katex';
import 'katex/dist/katex.min.css';

interface Props {
  tex: string;
  inline?: boolean;
  /** Short title shown above a display formula. */
  label?: string;
}

const { tex, inline = false, label } = Astro.props;
const html = katex.renderToString(tex, {
  displayMode: !inline,
  throwOnError: true,
  output: 'htmlAndMathml',
  strict: 'warn',
});
const hasExplanation = Astro.slots.has('default');
---

{
  inline ? (
    <span class="formula-inline" set:html={html} />
  ) : (
    <figure class="formula">
      {label && <p class="formula__label">{label}</p>}
      <div class="formula__math" tabindex="0" role="group" aria-label={label ?? 'Formula'} set:html={html} />
      {hasExplanation && (
        <figcaption class="formula__explanation">
          <slot />
        </figcaption>
      )}
    </figure>
  )
}

<style>
  .formula {
    padding: var(--space-4) var(--space-5);
    border: var(--border);
    border-left: 3px solid var(--orange);
    border-radius: var(--radius);
    background: var(--white);
  }

  .formula__label {
    font-size: var(--text-xs);
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--orange-text);
  }

  .formula__math {
    overflow-x: auto;
    overflow-y: hidden;
    padding-block: var(--space-2);
    font-size: 1.05rem;
  }

  .formula__math :global(.katex-display) {
    margin: 0.5em 0;
  }

  .formula__explanation {
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--gray-100);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: 1.6;
  }

  .formula__explanation :global(p + p) {
    margin-top: 0.6em;
  }

  .formula-inline :global(.katex) {
    font-size: 1.05em;
  }
</style>
