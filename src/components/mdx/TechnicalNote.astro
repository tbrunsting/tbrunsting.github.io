---
/**
 * Collapsible deep-dive for technical detail that most readers can skip:
 * implementation notes, rejected alternatives, sensitivity checks.
 * Uses native <details>, so it is keyboard-accessible with no JavaScript.
 *
 * MDX usage:
 *   <TechnicalNote title="Why not name-based joins?">...</TechnicalNote>
 */
interface Props {
  title: string;
  open?: boolean;
  label?: string;
}

const { title, open = false, label = 'Technical note' } = Astro.props;
---

<details class="tech-note" open={open}>
  <summary>
    <span class="tech-note__label">{label}</span>
    <span class="tech-note__title">{title}</span>
  </summary>
  <div class="tech-note__body">
    <slot />
  </div>
</details>

<style>
  .tech-note {
    border: var(--border);
    border-radius: var(--radius);
    background: var(--white);
  }

  summary {
    display: grid;
    gap: 0.1rem;
    padding: var(--space-4) var(--space-5);
    padding-right: 3rem;
    cursor: pointer;
    list-style: none;
    position: relative;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary::after {
    content: '';
    position: absolute;
    right: var(--space-5);
    top: 50%;
    width: 0.55rem;
    height: 0.55rem;
    border-right: 2px solid var(--orange-text);
    border-bottom: 2px solid var(--orange-text);
    transform: translateY(-70%) rotate(45deg);
    transition: transform var(--duration) var(--ease);
  }

  .tech-note[open] summary::after {
    transform: translateY(-30%) rotate(-135deg);
  }

  summary:hover .tech-note__title {
    text-decoration: underline;
    text-decoration-color: var(--gray-400);
  }

  .tech-note__label {
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .tech-note__title {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: var(--leading-snug);
  }

  .tech-note__body {
    padding: 0 var(--space-5) var(--space-5);
    font-size: 0.975rem;
  }

  .tech-note__body :global(> * + *) {
    margin-top: 0.8em;
  }
</style>
