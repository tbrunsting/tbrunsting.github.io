---
/**
 * A clearly separated set of project destinations: live dashboard, source
 * repository, downloadable original, documentation. Each card says what the
 * destination is, so readers never confuse the web dashboard with the source.
 *
 * MDX usage:
 *   <ResourceLinks
 *     title="Explore the project"
 *     items={[
 *       { kind: 'dashboard', label: 'Interactive dashboard', href: 'https://…', detail: 'Two pages, runs in the browser' },
 *       { kind: 'code', label: 'Source repository', href: 'https://github.com/…' },
 *       { kind: 'download', label: 'Original Power BI file', href: 'https://…/Dashboard.pbix', detail: '.pbix, 4.8 MB' },
 *     ]}
 *   />
 */
import Icon, { type IconName } from '../Icon.astro';

interface Item {
  kind: 'dashboard' | 'code' | 'download' | 'docs';
  label: string;
  href: string;
  detail?: string;
}

interface Props {
  items: Item[];
  title?: string;
}

const { items, title } = Astro.props;

const kinds: Record<Item['kind'], { icon: IconName; tag: string; action: string; download?: boolean }> = {
  dashboard: { icon: 'chart', tag: 'Live web dashboard', action: 'Open dashboard' },
  code: { icon: 'github', tag: 'Source code', action: 'View repository' },
  download: { icon: 'download', tag: 'Original file', action: 'Download', download: true },
  docs: { icon: 'book', tag: 'Documentation', action: 'Read the docs' },
};
---

<section class="resources wide" aria-label={title ?? 'Project resources'}>
  {title && <p class="resources__title">{title}</p>}
  <ul class="resources__list" role="list">
    {
      items.map((item) => {
        const k = kinds[item.kind];
        return (
          <li>
            <a
              class:list={['resource', `resource--${item.kind}`]}
              href={item.href}
              {...(k.download ? {} : { target: '_blank' })}
              rel="noopener"
            >
              <span class="resource__icon" aria-hidden="true">
                <Icon name={k.icon} />
              </span>
              <span class="resource__tag">{k.tag}</span>
              <span class="resource__label">{item.label}</span>
              {item.detail && <span class="resource__detail">{item.detail}</span>}
              <span class="resource__action">
                {k.action}
                <Icon name={k.download ? 'download' : 'external'} />
              </span>
              {!k.download && <span class="visually-hidden">(opens in a new tab)</span>}
            </a>
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  .resources {
    display: grid;
    gap: var(--space-4);
  }

  .resources__title {
    font-size: var(--text-xs);
    font-weight: 750;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--orange-text);
  }

  .resources__list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: var(--space-4);
    list-style: none;
    padding: 0;
    margin: 0 !important;
  }

  .resources__list li {
    margin: 0 !important;
  }

  .resource {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    height: 100%;
    padding: var(--space-5);
    border: var(--border);
    border-radius: var(--radius-lg);
    background: var(--white);
    color: var(--ink) !important;
    font-weight: 400 !important;
    text-decoration: none;
    transition:
      border-color var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease),
      transform var(--duration) var(--ease);
  }

  .resource:hover {
    border-color: var(--gray-400);
    box-shadow: var(--shadow);
    transform: translateY(-2px);
  }

  /* The live dashboard is the primary destination. */
  .resource--dashboard {
    background: var(--charcoal);
    border-color: var(--charcoal);
    color: var(--on-dark) !important;
  }

  .resource--dashboard:hover {
    border-color: var(--orange);
  }

  .resource__icon {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    margin-bottom: var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--orange-soft);
    color: var(--orange-text);
  }

  .resource--dashboard .resource__icon {
    background: rgb(255 112 73 / 0.15);
    color: var(--orange);
  }

  .resource__icon :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .resource__tag {
    font-size: var(--text-xs);
    font-weight: 750;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .resource--dashboard .resource__tag {
    color: var(--orange);
  }

  .resource__label {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 800;
    line-height: var(--leading-snug);
  }

  .resource__detail {
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  .resource--dashboard .resource__detail {
    color: var(--on-dark-muted);
  }

  .resource__action {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: var(--space-3);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--orange-text);
  }

  .resource--dashboard .resource__action {
    color: var(--orange);
  }

  .resource__action :global(svg) {
    width: 1rem;
    height: 1rem;
  }
</style>
