---
/**
 * Data pipeline diagram: an ordered row of stage cards joined by arrows.
 * On narrow screens the row scrolls horizontally inside its own container
 * rather than squeezing. Plain semantic HTML, readable by screen readers.
 *
 * MDX usage:
 *   <DataPipeline
 *     caption="From frozen sources to dashboard"
 *     steps={[
 *       { label: 'Ingest', detail: 'Frozen, checksummed sources', tools: ['Python'], icon: 'ingest' },
 *       { label: 'Warehouse', detail: 'Star schema', tools: ['PostgreSQL'], icon: 'database' },
 *     ]}
 *   />
 * Icons: ingest | database | sigma | layers | chart | code | target
 */
import Icon, { type IconName } from '../Icon.astro';

interface Step {
  label: string;
  detail?: string;
  tools?: string[];
  icon?: IconName;
}

interface Props {
  steps: Step[];
  caption?: string;
}

const { steps, caption } = Astro.props;
---

<figure class="pipeline wide">
  <div class="pipeline__scroll" tabindex="0" role="region" aria-label={caption ?? 'Data pipeline'}>
    <ol class="pipeline__steps">
      {
        steps.map((step, i) => (
          <li class="pipeline__step">
            <div class="pipeline__top">
              <span class="pipeline__icon" aria-hidden="true">
                <Icon name={step.icon ?? 'layers'} />
              </span>
              <span class="pipeline__index" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
            </div>
            <span class="pipeline__label">{step.label}</span>
            {step.detail && <span class="pipeline__detail">{step.detail}</span>}
            {step.tools && step.tools.length > 0 && <span class="pipeline__tools">{step.tools.join(' · ')}</span>}
          </li>
        ))
      }
    </ol>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .pipeline {
    padding: var(--space-5);
    border: var(--border);
    border-radius: var(--radius-lg);
    background: var(--paper-2);
  }

  .pipeline__scroll {
    overflow-x: auto;
    padding-bottom: var(--space-2);
    margin-bottom: calc(var(--space-2) * -1);
  }

  .pipeline__steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(9.5rem, 1fr);
    gap: var(--space-6);
    min-width: min-content;
  }

  .pipeline__step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: var(--space-4);
    border: var(--border);
    border-radius: var(--radius);
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }

  /* Connector arrows */
  .pipeline__step:not(:last-child)::after {
    content: '';
    position: absolute;
    top: 50%;
    right: calc(var(--space-6) * -1 + 0.55rem);
    width: 0.55rem;
    height: 0.55rem;
    border-right: 2px solid var(--orange);
    border-bottom: 2px solid var(--orange);
    transform: translateY(-50%) rotate(-45deg);
  }

  .pipeline__step:not(:last-child)::before {
    content: '';
    position: absolute;
    top: 50%;
    right: calc(var(--space-6) * -1 + 0.4rem);
    width: calc(var(--space-6) - 0.9rem);
    height: 2px;
    background: var(--orange-line);
  }

  .pipeline__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .pipeline__icon {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    border: 1.5px solid var(--orange-line);
    color: var(--orange-text);
  }

  .pipeline__icon :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .pipeline__index {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--gray-500);
    font-weight: 600;
  }

  .pipeline__label {
    font-family: var(--font-display);
    font-weight: 800;
    line-height: var(--leading-snug);
  }

  .pipeline__detail {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: 1.5;
  }

  .pipeline__tools {
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--orange-text);
  }

  figcaption {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }
</style>
