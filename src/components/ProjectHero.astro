---
/** "Project Snapshot" hero: title, question, context, tools, actions and stats. */
import ToolList from './ToolList.astro';
import ProjectStats from './ProjectStats.astro';
import Icon from './Icon.astro';
import { statusLabel, formatDate, type Project } from '@/lib/projects';
import { withBase } from '@/lib/paths';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, sport, category, timePeriod, question, tools, stats, status, githubUrl, dashboard, publishedAt, updatedAt } =
  project.data;
---

<header class="project-hero surface-darker">
  <div class="container project-hero__inner">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href={withBase('/projects/')}>Projects</a></li>
        <li aria-current="page">{title}</li>
      </ol>
    </nav>

    <div class="project-hero__head">
      <p class="project-hero__meta">
        <span class="eyebrow">{sport}</span>
        {category && <span class="badge">{category}</span>}
        <span class="badge badge--accent">
          <span class="badge__dot" aria-hidden="true" />
          {statusLabel[status]}
        </span>
      </p>
      <h1>{title}</h1>
      <div class="project-hero__question">
        <p class="project-hero__question-label">The question</p>
        <p class="project-hero__question-text">{question}</p>
      </div>
    </div>

    <dl class="project-hero__facts">
      <div>
        <dt>Sport</dt>
        <dd>{sport}</dd>
      </div>
      <div>
        <dt>Period</dt>
        <dd>{timePeriod}</dd>
      </div>
      {
        publishedAt && (
          <div>
            <dt>Published</dt>
            <dd>
              <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
            </dd>
          </div>
        )
      }
      {
        updatedAt && (
          <div>
            <dt>Updated</dt>
            <dd>
              <time datetime={updatedAt.toISOString()}>{formatDate(updatedAt)}</time>
            </dd>
          </div>
        )
      }
      {
        tools.length > 0 && (
          <div class="project-hero__tools">
            <dt>Tools</dt>
            <dd>
              <ToolList tools={tools} size="sm" />
            </dd>
          </div>
        )
      }
    </dl>

    {
      (githubUrl || dashboard.url) && (
        <div class="btn-row">
          {dashboard.url && (
            <a class="btn btn--primary" href={dashboard.url} target="_blank" rel="noopener">
              <Icon name="chart" />
              Open Interactive Dashboard
              <span class="visually-hidden">(opens in a new tab)</span>
            </a>
          )}
          {githubUrl && (
            <a class="btn btn--ghost" href={githubUrl} target="_blank" rel="noopener">
              <Icon name="github" />
              View source on GitHub
              <span class="visually-hidden">(opens in a new tab)</span>
            </a>
          )}
        </div>
      )
    }

    <ProjectStats stats={stats} />
  </div>
</header>

<style>
  .project-hero {
    padding-block: var(--space-6) clamp(2.5rem, 2rem + 3vw, 4rem);
  }

  .project-hero__inner {
    display: grid;
    gap: var(--space-6);
  }

  .breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    font-size: var(--text-xs);
    color: var(--on-dark-muted);
  }

  .breadcrumb li + li::before {
    content: '/';
    margin-right: 0.4rem;
    opacity: 0.6;
  }

  .breadcrumb a {
    color: var(--on-dark-muted);
  }

  .breadcrumb a:hover {
    color: var(--on-dark);
  }

  .project-hero__head {
    display: grid;
    gap: var(--space-5);
    max-width: 56rem;
  }

  .project-hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  h1 {
    font-size: var(--text-4xl);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .project-hero__question {
    border-left: 3px solid var(--accent);
    padding-left: var(--space-5);
    display: grid;
    gap: var(--space-1);
  }

  .project-hero__question-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }

  .project-hero__question-text {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 550;
    line-height: var(--leading-snug);
    max-width: 44rem;
  }

  .project-hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5) var(--space-7);
  }

  .project-hero__facts div {
    display: grid;
    gap: var(--space-1);
    align-content: start;
  }

  .project-hero__facts dt {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-dark-muted);
  }

  .project-hero__facts dd {
    font-weight: 600;
  }
</style>
